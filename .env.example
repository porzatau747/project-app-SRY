# Branch backend scraper credentials. Keep real values only in .env, never commit them.
BRANCH_BACKEND_BASE_URL=https://branch.nescen.in.th
BRANCH_BACKEND_BRANCH_ID=55000067
BRANCH_BACKEND_USERNAME=
BRANCH_BACKEND_PASSWORD=

# Scraper defaults
BRANCH_SCRAPER_MODE=all
BRANCH_STOCK_TIMEOUT_MS=120000
BRANCH_CATEGORY_TIMEOUT_MS=45000
BRANCH_CATEGORY_RETRIES=2
BRANCH_CATEGORY_DELAY_MS=2000
# Optional comma-separated category names. Empty = scrape every category.
BRANCH_PRICE_CATEGORIES=
