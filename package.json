{
  "name": "weekly-content-planner-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web-app",
    "build": "npm run build --workspaces",
    "sync:branch": "npx tsx apps/scraping-worker/src/stock-scraper.ts --mode=all",
    "sync:stock": "npx tsx apps/scraping-worker/src/stock-scraper.ts --mode=stock",
    "sync:price": "npx tsx apps/scraping-worker/src/stock-scraper.ts --mode=price",
    "sync:price:sample": "npx tsx apps/scraping-worker/src/stock-scraper.ts --mode=price --category-limit=2"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "cloakbrowser": "^0.3.31",
    "puppeteer-core": "^25.1.0"
  }
}
