// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  code      String @id
  product   String
  qty       Int
  cost      Float
  sellPrice Float
  itemType  String
  agingDays Int
}

model WeeklyPlanPost {
  id           String @id
  day          String
  postType     String
  productFocus String
  reason       String
  productCode  String
  category     String
  priority     String
  status       String
  reminderAt   String
  
  generatedAsset String?
}

model AppState {
  key   String @id
  value String
}

model PromotionBatch {
  id         String   @id
  name       String
  campaignType   String   @default("clearance")
  templatePreset String   @default("clearance")
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  exportedAt DateTime?

  items   PromotionItem[]
  exports PromotionExport[]
}

model PromotionItem {
  id                 String @id
  batchId            String
  productCode        String
  productName        String
  itemType           String
  qty                Int
  agingDays          Int
  cost               Float
  sellPrice          Float?
  margin             Float?
  score              Int
  reasonsJson        String
  recommendation     String
  reviewStatus       String
  generatedCopyJson  String
  sourceSnapshotJson String

  batch PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model PromotionExport {
  id        String   @id
  batchId   String
  format    String
  fileName  String
  rowCount  Int
  createdAt DateTime @default(now())

  batch PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}
